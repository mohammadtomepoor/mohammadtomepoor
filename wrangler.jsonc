{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohammadtomepoor",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2fa85232-7d04-4235-b7ab-37c543b82bc0","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1922f98de9b94d24942205e0e4e5e4b2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
